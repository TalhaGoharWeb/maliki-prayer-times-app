<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the user-supplied adhan recording: it is referenced only by NAME
     string from Dart (RawResourceAndroidNotificationSound('tunisi_adhan')),
     which the release resource shrinker cannot trace statically. Without
     this keep rule, minifyReleaseWithR8 strips res/raw/tunisi_adhan.mp3
     from the release APK and the adhan silently never plays. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@raw/tunisi_adhan" />
